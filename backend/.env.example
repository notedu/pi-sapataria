# Conexão com PostgreSQL (local, RDS ou outro provedor compatível).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=sapataria
# Habilite TLS em conexões remotas. DATABASE_CA_CERT é opcional.
DATABASE_SSL=false
DATABASE_CA_CERT=""

PORT=3030
# Em containers/serviços de nuvem, defina HOST=0.0.0.0 para aceitar conexões externas.
HOST="127.0.0.1"

# Chave aleatória de assinatura das sessões; mantenha a mesma nas instâncias.
SESSION_SECRET=""
APP_ORIGIN="http://localhost:5173"

# Em produção: HTTPS e origem real do front-end.
NODE_ENV="development"
# Preencha apenas com os endereços/redes confiáveis do proxy ou load balancer.
TRUST_PROXY=""
